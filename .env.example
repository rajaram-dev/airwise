# Copy this file to .env and fill in real values. Never commit .env.

# Google Gemini API key (free from https://aistudio.google.com)
GEMINI_API_KEY=

# Main Gemini model, then comma-separated fallbacks tried if it fails (e.g. quota used up)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash

# How long identical AI plan wording is reused, in seconds (saves free-tier quota)
AI_CACHE_TTL_SECONDS=3600

# Comma-separated list of allowed browser origins (CORS)
ALLOWED_ORIGINS=http://localhost:8000

# How long air-quality responses are cached, in seconds
CACHE_TTL_SECONDS=600

# Rate limits per client IP
RATE_LIMIT_PLAN=10/minute
RATE_LIMIT_CHAT=20/minute

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
